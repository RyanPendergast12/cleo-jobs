FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /app
COPY requirements-apply.txt requirements-browser.txt ./
RUN pip install --no-cache-dir -r requirements-browser.txt && python -m playwright install --with-deps chromium
COPY . .
CMD ["python", "jobapply_service.py"]

