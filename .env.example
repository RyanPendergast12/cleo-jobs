# ─── jobwatch.py (the scheduled scanner) ───────────────────────────────
# Only DISCORD_WEBHOOK_URL is required; everything else is optional and the
# matching source/feature is skipped when its variable is blank.

DISCORD_WEBHOOK_URL=          # required — Cleo's #cleo-jobs Discord webhook
JOB_MAP_WEBHOOK_URL=          # optional — Cleo-specific market trend channel
JOB_READINESS_WEBHOOK_URL=    # optional — Cleo-specific readiness channel
NEEDED_SKILLS_WEBHOOK_URL=    # optional — Cleo-specific needed-skills channel
JOBWATCH_ONLINE_ENRICHMENT_ENABLED=true  # re-score initially eligible jobs from verified public text
JOBWATCH_SEARCH_FALLBACK_ENABLED=true    # allow bounded public search when the saved URL is incomplete

JOBDATA_API_KEY=             # unused while the cybersecurity-specific foorilla source is disabled
ADZUNA_APP_ID=              # optional — developer.adzuna.com (free); enables the adzuna source
ADZUNA_APP_KEY=

GMAIL_USER=                 # optional — Gmail address receiving Indeed job-alert emails
GMAIL_APP_PASSWORD=         # optional — 16-char Gmail App Password (needs 2-Step Verification),
                            # used read-only by the IMAP email adapters

GSHEET_WEBAPP_URL=          # optional — /exec URL of the Apps Script web app bound to the
                            # application-ledger sheet. Adds the real recruiter/interview
                            # callback-rate overlay to the readiness octagram. See README.
GSHEET_WEBAPP_TOKEN=        # optional — the shared secret that Apps Script checks (?token=)

# ─── jobapply_service.py (the separate résumé-prep service) ────────────
# Not needed to run the scanner. See JOB_APPLY.md for the full setup.

JOB_APPLY_SERVICE_URL=      # https URL the scanner POSTs eligible candidates to
JOB_APPLY_INGEST_TOKEN=     # shared secret, >= 32 chars
DISCORD_BOT_TOKEN=          # bot token (not a webhook) for the #job-apply review channel
JOB_APPLY_CHANNEL_ID=       # numeric Cleo application-review channel ID
JOB_APPLY_OWNER_ID=         # your numeric Discord user ID
JOB_APPLY_DB=/data/applications.sqlite3
JOB_APPLY_PREPARE_ENABLED=false   # keep false until the Anthropic settings below are set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # e.g. claude-sonnet-5

# ─── employer form auto-apply (needs Chromium; see JOB_APPLY.md) ───────
JOB_APPLY_FORMS_ENABLED=false       # enables read-only form inspection after Chromium is installed
JOB_APPLY_TRANSMIT_ENABLED=false    # independent hard gate; false forbids fill/upload/click/submit
JOB_APPLY_TRANSMIT_ATS=             # comma-separated transmission-ready IDs: greenhouse,ashby,fountain,subway
JOB_APPLY_PROFILE=                  # optional; defaults to profiles/apply_profile.json
JOB_APPLY_PROFILE_JSON=             # the whole profile as one secret variable, for hosts
                                    # that deploy from Git (the file itself is gitignored)
JOB_APPLY_BROWSER_DATA=             # optional; defaults to browser/ beside JOB_APPLY_DB
JOB_APPLY_AUTO_SUBMIT_MIN_SCORE=90  # match score Approve & auto-apply needs to run unattended
